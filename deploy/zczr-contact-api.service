[Unit]
Description=ZCZR contact form API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nginx
Group=nginx
WorkingDirectory=/opt/zczr-drinkware-site
EnvironmentFile=/etc/zczr/contact-api.env
ExecStart=/usr/local/bin/node /opt/zczr-drinkware-site/server/contact-api.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
