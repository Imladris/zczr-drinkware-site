---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Newsletter from '../../../components/Newsletter.astro';
import { articlesZh as articles } from '../../../i18n/resources.zh';

const [feature, ...rest] = articles;
---

<BaseLayout
  title="采购商资源"
  description="采购保温饮具的实用指南：如何准备定制项目、评估真空保温性能、规划出口包装。"
  current="resources"
  lang="zh"
>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__top">
        <span class="eyebrow">资源 / 采购商指南</span>
        <span class="page-hero__meta">面向采购与产品团队</span>
      </div>
      <h1>写出<em>更好的需求简报。</em></h1>
      <div class="page-hero__bottom">
        <p>关于保温饮具规格、样品和运输的实用笔记。为希望减少返工、让生产沟通更清晰的采购商而写。</p>
        <div class="page-hero__meta"><span>03 篇指南</span><span>2026 年更新</span></div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <article class="journal-feature">
        <a class="journal-feature__media reveal" href={`/zh/resources/${feature.slug}/`} aria-label={`阅读 ${feature.title}`}>
          <img src={feature.image} alt={feature.imageAlt} width="1600" height="1067" fetchpriority="high" />
        </a>
        <div class="journal-feature__copy reveal reveal-delay-1">
          <div class="journal-card__meta">
            <span>{feature.category}</span>
            <span>{feature.date} · {feature.readTime}</span>
          </div>
          <h2>{feature.title}</h2>
          <p>{feature.excerpt}</p>
          <a class="text-link" href={`/zh/resources/${feature.slug}/`}>阅读指南 <span aria-hidden="true">↗</span></a>
        </div>
      </article>

      <div class="journal-grid journal-grid--two">
        {rest.map((article, index) => (
          <article class:list={['journal-card', 'reveal', `reveal-delay-${index}`]}>
            <a href={`/zh/resources/${article.slug}/`} aria-label={`阅读 ${article.title}`}>
              <div class="journal-card__media">
                <img src={article.image} alt={article.imageAlt} width="1600" height="1067" loading="lazy" />
              </div>
              <div class="journal-card__meta">
                <span>{article.category}</span>
                <span>{article.date} · {article.readTime}</span>
              </div>
              <h3>{article.title}</h3>
              <p>{article.excerpt}</p>
              <span class="journal-card__link">阅读指南</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Newsletter lang="zh" />
</BaseLayout>
