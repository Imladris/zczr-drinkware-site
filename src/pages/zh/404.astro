---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="未找到该页面。请返回 ZCZR 饮具系列，或联系我们的团队。" noIndex lang="zh">
  <section class="error-page">
    <div>
      <span class="eyebrow">404 / 偏离路线</span>
      <h1>走错<em>方向了。</em></h1>
      <p>这个页面不在我们的地图上。请返回饮具系列，或直接联系我们的团队。</p>
      <a class="btn btn--solid" href="/zh/">返回首页 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
