---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable" description="La page demandée est introuvable. Revenez à la gamme de gobelets ZCZR ou contactez notre équipe." noIndex lang="fr">
  <section class="error-page">
    <div>
      <span class="eyebrow">404 / Hors sentier</span>
      <h1>Mauvais <em>virage.</em></h1>
      <p>Cette page n'est pas sur la carte. Revenez à la gamme de gobelets ou contactez directement notre équipe.</p>
      <a class="btn btn--solid" href="/fr/">Retour à l'accueil <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
