---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Newsletter from '../../../components/Newsletter.astro';
import { articlesFr as articles } from '../../../i18n/resources.fr';

const [feature, ...rest] = articles;
---

<BaseLayout
  title="Ressources pour les acheteurs"
  description="Guides pratiques pour l'achat de gobelets isothermes : préparer un programme personnalisé, évaluer l'isolation sous vide et planifier l'emballage d'exportation."
  current="resources"
  lang="fr"
>
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__top">
        <span class="eyebrow">Ressources / Guides pour les acheteurs</span>
        <span class="page-hero__meta">Pour les équipes achats et produit</span>
      </div>
      <h1>Des notes pour <em>de meilleurs briefs.</em></h1>
      <div class="page-hero__bottom">
        <p>Des notes pratiques sur la spécification, les échantillons et l'expédition des gobelets isothermes. Rédigées pour les acheteurs qui veulent moins de révisions et une conversation de production plus claire.</p>
        <div class="page-hero__meta"><span>03 guides</span><span>Mis à jour en 2026</span></div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <article class="journal-feature">
        <a class="journal-feature__media reveal" href={`/fr/resources/${feature.slug}/`} aria-label={`Lire ${feature.title}`}>
          <img src={feature.image} alt={feature.imageAlt} width="1600" height="1067" fetchpriority="high" />
        </a>
        <div class="journal-feature__copy reveal reveal-delay-1">
          <div class="journal-card__meta">
            <span>{feature.category}</span>
            <span>{feature.date} · {feature.readTime}</span>
          </div>
          <h2>{feature.title}</h2>
          <p>{feature.excerpt}</p>
          <a class="text-link" href={`/fr/resources/${feature.slug}/`}>Lire le guide <span aria-hidden="true">↗</span></a>
        </div>
      </article>

      <div class="journal-grid journal-grid--two">
        {rest.map((article, index) => (
          <article class:list={['journal-card', 'reveal', `reveal-delay-${index}`]}>
            <a href={`/fr/resources/${article.slug}/`} aria-label={`Lire ${article.title}`}>
              <div class="journal-card__media">
                <img src={article.image} alt={article.imageAlt} width="1600" height="1067" loading="lazy" />
              </div>
              <div class="journal-card__meta">
                <span>{article.category}</span>
                <span>{article.date} · {article.readTime}</span>
              </div>
              <h3>{article.title}</h3>
              <p>{article.excerpt}</p>
              <span class="journal-card__link">Lire le guide</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Newsletter lang="fr" />
</BaseLayout>
