---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page could not be found. Return to the ZCZR drinkware range or contact our team." noIndex>
  <section class="error-page">
    <div>
      <span class="eyebrow">404 / Off trail</span>
      <h1>Wrong <em>turn.</em></h1>
      <p>This page is not on the map. Head back to the drinkware range, or contact our team directly.</p>
      <a class="btn btn--solid" href="/">Back to home <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
