  <section class="error-page">
    <div>
      <span class="eyebrow">404 / Fuera de ruta</span>
      <h1>Giro <em>equivocado.</em></h1>
      <p>Esta página no está en el mapa. Vuelve a la gama de menaje o contacta directamente con nuestro equipo.</p>
      <a class="btn btn--solid" href="/es/">Volver al inicio <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
