<div class="video-modal" data-video-modal aria-hidden="true">
  <div class="video-modal__backdrop" data-video-close></div>
  <div class="video-modal__dialog" role="dialog" aria-modal="true" aria-label="Video player">
    <div class="video-modal__head">
      <p class="eyebrow" data-video-label>Field film</p>
      <button class="icon-button icon-button--light" type="button" data-video-close aria-label="Close video">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    </div>
    <div class="video-modal__frame" data-video-frame></div>
    <p class="video-modal__note">Video is loaded from YouTube only after you press play.</p>
  </div>
</div>
