---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { products, type Product } from '../data/products';
import { localizeProduct } from '../i18n/products.es';
import { localePath, type Lang } from '../i18n/ui';

interface Props {
  product: Product;
  lang?: Lang;
}

const { product: source, lang = 'en' } = Astro.props as Props;
const product = localizeProduct(source, lang);
const related = products.filter((item) => item.slug !== source.slug).slice(0, 3);
const copies = {
  en: {
    crumbHome: 'Home',
    crumbRange: 'Drinkware',
    imageNote: 'Product images for visual reference. Colors, accessories and packing are confirmed on the approved sample.',
    intro: 'Product image for visual reference. Contact our team to confirm specifications, MOQ, finishes and packing.',
    reference: 'Reference',
    category: 'Category',
    capacity: 'Capacity',
    customization: 'Customization',
    prev: 'Previous image',
    next: 'Next image',
    view: 'View',
    quote: 'Request a quote',
    sample: 'Request a sample',
    aboutTitle: 'About these images',
    aboutBody: 'The images are used as a visual reference. They do not replace the physical sample or the agreed specification.',
    orderTitle: 'Orders & samples',
    orderBody: 'MOQ, price, lead time and customization are confirmed per project. Share the model, quantity and destination market to receive a quotation.',
    relatedEyebrow: 'Related models',
    relatedTitleA: 'More',
    relatedTitleB: 'references.',
    all: 'All drinkware',
  },
  es: {
    crumbHome: 'Inicio',
    crumbRange: 'Menaje',
    imageNote: 'Imágenes de producto para referencia visual. El color, los accesorios y el embalaje se confirman con la muestra aprobada.',
    intro: 'Imagen de producto para referencia visual. Contacta con nuestro equipo para confirmar especificaciones, MOQ, acabados y embalaje.',
    reference: 'Referencia',
    category: 'Categoría',
    capacity: 'Capacidad',
    customization: 'Personalización',
    prev: 'Imagen anterior',
    next: 'Imagen siguiente',
    view: 'Vista',
    quote: 'Solicitar cotización',
    sample: 'Solicitar muestra',
    aboutTitle: 'Sobre las imágenes',
    aboutBody: 'Las imágenes se utilizan como referencia visual. No sustituyen a la muestra física ni a la especificación acordada.',
    orderTitle: 'Pedidos y muestras',
    orderBody: 'El MOQ, el precio, el plazo y la personalización se confirman por proyecto. Comparte el modelo, la cantidad y el mercado de destino para recibir una cotización.',
    relatedEyebrow: 'Modelos relacionados',
    relatedTitleA: 'Más',
    relatedTitleB: 'referencias.',
    all: 'Todo el menaje',
  },
  fr: {
    crumbHome: 'Accueil',
    crumbRange: 'Gobelets',
    imageNote: 'Images produits à titre indicatif. Les couleurs, accessoires et emballages sont confirmés sur l’échantillon approuvé.',
    intro: 'Image produit à titre indicatif. Contactez notre équipe pour confirmer les spécifications, le MOQ, les finitions et l’emballage.',
    reference: 'Référence',
    category: 'Catégorie',
    capacity: 'Capacité',
    customization: 'Personnalisation',
    prev: 'Image précédente',
    next: 'Image suivante',
    view: 'Vue',
    quote: 'Demander un devis',
    sample: 'Demander un échantillon',
    aboutTitle: 'À propos des images',
    aboutBody: 'Les images sont utilisées à titre indicatif. Elles ne remplacent pas l’échantillon physique ni la spécification convenue.',
    orderTitle: 'Commandes et échantillons',
    orderBody: 'Le MOQ, le prix, le délai et la personnalisation sont confirmés par projet. Indiquez le modèle, la quantité et le marché de destination pour recevoir un devis.',
    relatedEyebrow: 'Modèles associés',
    relatedTitleA: 'Autres',
    relatedTitleB: 'références.',
    all: 'Tous les gobelets',
  },
  zh: {
    crumbHome: '首页',
    crumbRange: '饮具',
    imageNote: '产品图片仅供参考。颜色、配件和包装以确认样品为准。',
    intro: '产品图片仅供参考。请联系我们的团队确认规格、MOQ、表面工艺和包装。',
    reference: '参考',
    category: '类别',
    capacity: '容量',
    customization: '定制',
    prev: '上一张',
    next: '下一张',
    view: '图片',
    quote: '获取报价',
    sample: '申请样品',
    aboutTitle: '关于图片',
    aboutBody: '图片仅供参考，不能替代实物样品或双方确认的规格。',
    orderTitle: '订单与样品',
    orderBody: 'MOQ、价格、交期和定制内容按项目确认。请提供型号、数量和目标市场，以便我们报价。',
    relatedEyebrow: '相关型号',
    relatedTitleA: '更多',
    relatedTitleB: '参考型号。',
    all: '全部饮具',
  },
} as const;

const copy = copies[lang];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: copy.intro,
  image: [new URL(product.image, Astro.site)],
  brand: { '@type': 'Brand', name: 'ZCZR' },
  category: product.categoryLabel,
  manufacturer: {
    '@type': 'Organization',
    name: 'Wuxi Zhenchuang Zhuorui International Trade Co., Ltd.',
  },
};
---

<BaseLayout
  title={product.name}
  description={copy.intro}
  current="shop"
  image={product.image}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
  </Fragment>

  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localePath(lang, '/')}>{copy.crumbHome}</a><span>/</span>
      <a href={localePath(lang, '/collections/')}>{copy.crumbRange}</a><span>/</span>
      <span aria-current="page">{product.shortName}</span>
    </nav>

    <div class="product-layout">
      <div class="product-gallery" data-gallery>
        <div class="product-stage product-stage--photo" style={`--stage:${product.stage}`}>
          <span class="product-stage__tag">{product.line} / {product.capacity}</span>
          <img
            class="product-stage__photo"
            src={product.gallery[0]}
            alt={product.imageAlt}
            width="1200"
            height="1200"
            fetchpriority="high"
            data-gallery-image
          />
          {product.gallery.length > 1 && (
            <>
              <button class="gallery-arrow gallery-arrow--prev" type="button" data-gallery-prev aria-label={copy.prev}>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="1.5"/></svg>
              </button>
              <button class="gallery-arrow gallery-arrow--next" type="button" data-gallery-next aria-label={copy.next}>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.5"/></svg>
              </button>
              <span class="gallery-counter"><span data-gallery-current>1</span> / {product.gallery.length}</span>
            </>
          )}
        </div>
        {product.gallery.length > 1 && (
          <div class="product-thumbs" data-gallery-thumbs>
            {product.gallery.map((src, index) => (
              <button
                class:list={['product-thumb', { 'is-active': index === 0 }]}
                type="button"
                data-gallery-thumb
                data-src={src}
                data-alt={`${product.imageAlt} — ${copy.view} ${index + 1}`}
                aria-label={`${copy.view} ${index + 1}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                <img src={src} alt="" width="1200" height="1200" loading={index === 0 ? 'eager' : 'lazy'} />
              </button>
            ))}
          </div>
        )}
        <p class="product-image-note">{copy.imageNote}</p>
      </div>

      <div class="product-info">
        <span class="product-info__line">{product.line} · {product.categoryLabel}</span>
        <h1>{product.name}</h1>
        <p class="product-info__desc">{copy.intro}</p>

        <div class="company-facts" style="grid-template-columns: 1fr 1fr; margin-top: 26px;">
          <div class="company-fact"><span>{copy.category}</span><strong>{product.categoryLabel}</strong></div>
          <div class="company-fact"><span>{copy.capacity}</span><strong>{product.capacity}</strong></div>
          <div class="company-fact"><span>{copy.customization}</span><strong>OEM / ODM</strong></div>
          <div class="company-fact"><span>{copy.reference}</span><strong>{product.shortName}</strong></div>
        </div>

        <div class="product-actions">
          <a class="btn btn--solid" href={localePath(lang, '/contact/')}>{copy.quote} <span aria-hidden="true">↗</span></a>
          <a class="wishlist-button" href={localePath(lang, '/contact/')} aria-label={copy.sample}>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="1.3"/></svg>
          </a>
        </div>
        <p class="product-note">{copy.orderBody}</p>

        <div class="accordion-list">
          <details class="accordion" open>
            <summary>{copy.aboutTitle}</summary>
            <div class="accordion__body">
              <p>{copy.aboutBody}</p>
            </div>
          </details>
          <details class="accordion">
            <summary>{copy.orderTitle}</summary>
            <div class="accordion__body">
              <p>{copy.orderBody}</p>
            </div>
          </details>
        </div>

      </div>
    </div>

    <section class="section section--tight">
      <div class="section-head">
        <div class="section-head__title">
          <span class="eyebrow">{copy.relatedEyebrow}</span>
          <h2>{copy.relatedTitleA} <em>{copy.relatedTitleB}</em></h2>
        </div>
        <a class="text-link" href={localePath(lang, '/collections/')}>{copy.all} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="product-grid">
        {related.map((item, index) => (
          <ProductCard product={item} index={index} lang={lang} />
        ))}
      </div>
    </section>
  </div>

  <Newsletter lang={lang} />
</BaseLayout>

<style>
  .product-stage--photo {
    display: grid;
    place-items: center;
  }

  .product-stage__photo {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4%;
    mix-blend-mode: multiply;
  }

  .product-stage--photo:hover .product-stage__photo {
    transform: none;
  }

  .product-image-note {
    margin-top: 10px;
    font-size: 9px;
    line-height: 1.6;
    color: var(--ink-soft);
    opacity: 0.65;
  }

  .gallery-arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid rgba(21, 33, 27, 0.18);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    transform: translateY(-50%);
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .gallery-arrow:hover {
    background: var(--paper);
    transform: translateY(-50%) scale(1.05);
  }

  .gallery-arrow--prev { left: 18px; }
  .gallery-arrow--next { right: 18px; }

  .gallery-arrow svg {
    width: 20px;
    height: 20px;
  }

  .gallery-counter {
    position: absolute;
    right: 18px;
    bottom: 16px;
    z-index: 3;
    padding: 6px 10px;
    background: rgba(255, 255, 255, 0.9);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .product-thumbs {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .product-thumb {
    padding: 5%;
    background: #fff;
    border: 1px solid var(--line);
  }

  .product-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .product-thumb.is-active {
    border-color: var(--ink);
  }

  @media (max-width: 760px) {
    .product-stage__photo {
      padding: 2%;
    }

    .gallery-arrow {
      width: 36px;
      height: 36px;
    }

    .gallery-arrow--prev { left: 10px; }
    .gallery-arrow--next { right: 10px; }
  }
</style>
