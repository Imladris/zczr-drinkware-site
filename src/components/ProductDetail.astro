---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { products, type Product } from '../data/products';
import { localizeProduct } from '../i18n/products.es';
import { localePath, type Lang } from '../i18n/ui';

interface Props {
  product: Product;
  lang?: Lang;
}

const { product: source, lang = 'en' } = Astro.props as Props;
const product = localizeProduct(source, lang);
const related = products.filter((item) => item.slug !== source.slug).slice(0, 3);
const es = lang === 'es';

const copy = es
  ? {
      crumbHome: 'Inicio',
      crumbRange: 'Menaje',
      imageNote: 'Imagen de referencia del catálogo del proveedor. El color, los accesorios y el embalaje se confirman con la muestra.',
      intro: 'Imagen de referencia del catálogo de productos ZCZR en 1688. Contacta con nuestro equipo para confirmar especificaciones, MOQ, acabados y embalaje.',
      reference: 'Referencia',
      category: 'Categoría',
      capacity: 'Capacidad',
      customization: 'Personalización',
      source: 'Publicación original',
      sourceLink: 'Ver en 1688',
      quote: 'Solicitar cotización',
      sample: 'Solicitar muestra',
      aboutTitle: 'Sobre esta imagen',
      aboutBody: 'La imagen se ha tomado de la publicación del producto en 1688 y se utiliza como referencia visual. No sustituye a la muestra física ni a la especificación acordada.',
      orderTitle: 'Pedidos y muestras',
      orderBody: 'El MOQ, el precio, el plazo y la personalización se confirman por proyecto. Comparte el modelo, la cantidad y el mercado de destino para recibir una cotización.',
      relatedEyebrow: 'Modelos relacionados',
      relatedTitleA: 'Más',
      relatedTitleB: 'referencias.',
      all: 'Todo el menaje',
    }
  : {
      crumbHome: 'Home',
      crumbRange: 'Drinkware',
      imageNote: 'Reference image from the supplier catalogue. Color, accessories and packing are confirmed on the approved sample.',
      intro: 'Reference image from the ZCZR product catalogue on 1688. Contact our team to confirm specifications, MOQ, finishes and packing.',
      reference: 'Reference',
      category: 'Category',
      capacity: 'Capacity',
      customization: 'Customization',
      source: 'Original listing',
      sourceLink: 'View on 1688',
      quote: 'Request a quote',
      sample: 'Request a sample',
      aboutTitle: 'About this image',
      aboutBody: 'The image is taken from the product listing on 1688 and used as a visual reference. It does not replace the physical sample or the agreed specification.',
      orderTitle: 'Orders & samples',
      orderBody: 'MOQ, price, lead time and customization are confirmed per project. Share the model, quantity and destination market to receive a quotation.',
      relatedEyebrow: 'Related models',
      relatedTitleA: 'More',
      relatedTitleB: 'references.',
      all: 'All drinkware',
    };

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: copy.intro,
  image: [new URL(product.image, Astro.site)],
  brand: { '@type': 'Brand', name: 'ZCZR' },
  category: product.categoryLabel,
  manufacturer: {
    '@type': 'Organization',
    name: 'Wuxi Zhenchuang Zhuorui International Trade Co., Ltd.',
  },
};
---

<BaseLayout
  title={product.name}
  description={copy.intro}
  current="shop"
  image={product.image}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
  </Fragment>

  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localePath(lang, '/')}>{copy.crumbHome}</a><span>/</span>
      <a href={localePath(lang, '/collections/')}>{copy.crumbRange}</a><span>/</span>
      <span aria-current="page">{product.shortName}</span>
    </nav>

    <div class="product-layout">
      <div class="product-gallery">
        <div class="product-stage product-stage--photo" style={`--stage:${product.stage}`}>
          <span class="product-stage__tag">{product.line} / {product.capacity}</span>
          <img
            class="product-stage__photo"
            src={product.image}
            alt={product.imageAlt}
            width="1200"
            height="1200"
            fetchpriority="high"
          />
        </div>
        <p class="product-image-note">{copy.imageNote}</p>
      </div>

      <div class="product-info">
        <span class="product-info__line">{product.line} · {product.categoryLabel}</span>
        <h1>{product.name}</h1>
        <p class="product-info__desc">{copy.intro}</p>

        <div class="company-facts" style="grid-template-columns: 1fr 1fr; margin-top: 26px;">
          <div class="company-fact"><span>{copy.category}</span><strong>{product.categoryLabel}</strong></div>
          <div class="company-fact"><span>{copy.capacity}</span><strong>{product.capacity}</strong></div>
          <div class="company-fact"><span>{copy.customization}</span><strong>OEM / ODM</strong></div>
          <div class="company-fact"><span>{copy.reference}</span><strong>{product.shortName}</strong></div>
        </div>

        <div class="product-actions">
          <a class="btn btn--solid" href={localePath(lang, '/contact/')}>{copy.quote} <span aria-hidden="true">↗</span></a>
          <a class="wishlist-button" href={localePath(lang, '/contact/')} aria-label={copy.sample}>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="1.3"/></svg>
          </a>
        </div>
        <p class="product-note">{copy.orderBody}</p>

        <div class="accordion-list">
          <details class="accordion" open>
            <summary>{copy.aboutTitle}</summary>
            <div class="accordion__body">
              <p>{copy.aboutBody}</p>
            </div>
          </details>
          <details class="accordion">
            <summary>{copy.orderTitle}</summary>
            <div class="accordion__body">
              <p>{copy.orderBody}</p>
            </div>
          </details>
        </div>

        <p class="product-source">
          <span>{copy.source}</span>
          <a href={product.sourceUrl} target="_blank" rel="noopener noreferrer">{copy.sourceLink} <span aria-hidden="true">↗</span></a>
        </p>
      </div>
    </div>

    <section class="section section--tight">
      <div class="section-head">
        <div class="section-head__title">
          <span class="eyebrow">{copy.relatedEyebrow}</span>
          <h2>{copy.relatedTitleA} <em>{copy.relatedTitleB}</em></h2>
        </div>
        <a class="text-link" href={localePath(lang, '/collections/')}>{copy.all} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="product-grid">
        {related.map((item, index) => (
          <ProductCard product={item} index={index} lang={lang} />
        ))}
      </div>
    </section>
  </div>

  <Newsletter lang={lang} />
</BaseLayout>

<style>
  .product-stage--photo {
    display: grid;
    place-items: center;
  }

  .product-stage__photo {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4%;
    mix-blend-mode: multiply;
  }

  .product-stage--photo:hover .product-stage__photo {
    transform: none;
  }

  .product-image-note {
    margin-top: 10px;
    font-size: 9px;
    line-height: 1.6;
    color: var(--ink-soft);
    opacity: 0.65;
  }

  .product-source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 22px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .product-source a {
    font-weight: 800;
    color: var(--ink);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  @media (max-width: 760px) {
    .product-stage__photo {
      padding: 2%;
    }
  }
</style>
