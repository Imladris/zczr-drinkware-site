---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { products, type Product } from '../data/products';
import { localizeProduct, localizeSpecLabel, localizeSpecValue } from '../i18n/products.es';
import { localePath, ui, type Lang } from '../i18n/ui';

interface Props {
  product: Product;
  lang?: Lang;
}

const { product: source, lang = 'en' } = Astro.props as Props;
const product = localizeProduct(source, lang);
const t = ui[lang].product;
const related = products.filter((item) => item.slug !== source.slug).slice(0, 3);
const materialSpec = source.specs.find((spec) => spec.label === 'Material')?.value ?? '';

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  image: [new URL(product.image, Astro.site)],
  brand: { '@type': 'Brand', name: 'ZCZR' },
  category: product.categoryLabel,
  manufacturer: {
    '@type': 'Organization',
    name: 'Wuxi Zhenchuang Zhuorui International Trade Co., Ltd.',
  },
};
---

<BaseLayout
  title={product.name}
  description={lang === 'es'
    ? `${product.description} Menaje isotérmico OEM / ODM de ZCZR en Wuxi, Jiangsu.`
    : `${product.description} OEM / ODM insulated drinkware from ZCZR in Wuxi, Jiangsu.`}
  current="shop"
  image={product.image}
  lang={lang}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
  </Fragment>

  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={localePath(lang, '/')}>{lang === 'es' ? 'Inicio' : 'Home'}</a><span>/</span>
      <a href={localePath(lang, '/collections/')}>{lang === 'es' ? 'Menaje' : 'Drinkware'}</a><span>/</span>
      <span aria-current="page">{product.shortName}</span>
    </nav>

    <div class="product-layout">
      <div class="product-gallery">
        <div class="product-stage product-stage--photo" style={`--stage:${product.stage}`}>
          <span class="product-stage__tag">{product.line} / {product.capacity}</span>
          {product.badge && <span class="product-stage__badge">{product.badge}</span>}
          <img
            class="product-stage__photo"
            src={product.image}
            alt={product.imageAlt}
            width="1200"
            height="1200"
            fetchpriority="high"
          />
        </div>
        <p class="product-image-note">{t.imageNote}</p>
      </div>

      <div class="product-info">
        <span class="product-info__line">{product.line} · {product.categoryLabel}</span>
        <h1>{product.name}</h1>
        <p class="product-info__desc">{product.longDescription}</p>

        <div class="option-block">
          <div class="option-block__head">
            <span>{t.referenceColors}</span>
            <small>{product.colors.length} {t.colorsShown}</small>
          </div>
          <div class="color-options" aria-label={t.referenceColors}>
            {product.colors.map((color) => (
              <span class="color-option is-static" style={`--swatch:${color.hex}`} title={color.name}></span>
            ))}
          </div>
          <p class="color-list">{product.colors.map((color) => color.name).join(' · ')}</p>
        </div>

        <div class="company-facts" style="grid-template-columns: 1fr 1fr; margin-top: 26px;">
          <div class="company-fact"><span>{t.referenceCapacity}</span><strong>{product.capacity}</strong></div>
          <div class="company-fact"><span>{t.customization}</span><strong>OEM / ODM</strong></div>
          <div class="company-fact"><span>{t.material}</span><strong>{localizeSpecValue(lang, 'Material', materialSpec)}</strong></div>
          <div class="company-fact"><span>{t.moq}</span><strong>{t.onRequest}</strong></div>
        </div>

        <div class="option-block">
          <div class="option-block__head">
            <span>{t.customization}</span>
            <small>{t.developed}</small>
          </div>
          <div class="custom-tags">
            <span>{t.customBody}</span><span>{t.customLogo}</span><span>{t.customFinish}</span><span>{t.customLid}</span><span>{t.customPackaging}</span><span>{t.customManual}</span>
          </div>
        </div>

        <div class="product-actions">
          <a class="btn btn--solid" href={localePath(lang, '/contact/')}>{lang === 'es' ? 'Solicitar cotización' : 'Request a quote'} <span aria-hidden="true">↗</span></a>
          <a class="wishlist-button" href={localePath(lang, '/contact/')} aria-label={lang === 'es' ? 'Solicitar una muestra' : 'Ask for a sample'}>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="1.3"/></svg>
          </a>
        </div>
        <p class="product-note">{t.note}</p>

        <div class="accordion-list">
          <details class="accordion" open>
            <summary>{t.modelNotes}</summary>
            <div class="accordion__body">
              <p>{product.story}</p>
              <p>{t.modelNotesBody}</p>
            </div>
          </details>
          <details class="accordion">
            <summary>{t.specs}</summary>
            <div class="accordion__body">
              <table class="spec-table">
                <tbody>
                  {source.specs.map((spec) => (
                    <tr>
                      <th scope="row">{localizeSpecLabel(lang, spec.label)}</th>
                      <td>{localizeSpecValue(lang, spec.label, spec.value)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p style="margin-top: 12px; font-size: 10.5px; opacity: .7;">{t.specsNote}</p>
            </div>
          </details>
          <details class="accordion">
            <summary>{t.sampling}</summary>
            <div class="accordion__body">
              <p>{t.samplingBody}</p>
            </div>
          </details>
          <details class="accordion">
            <summary>{t.packing}</summary>
            <div class="accordion__body">
              <p>{t.packingBody}</p>
            </div>
          </details>
        </div>
      </div>
    </div>

    <div class="product-story">
      <div class="product-story__media">
        <img src="/images/company.webp" alt={lang === 'es' ? 'Recepción e imagen de marca de ZCZR' : 'ZCZR company reception and brand wall'} width="1800" height="1013" loading="lazy" />
      </div>
      <div>
        <span class="eyebrow">{t.platformEyebrow}</span>
        <h2>{t.platformTitleA} <em>{t.platformTitleB}</em></h2>
        <p>{t.platformBody.replace('{name}', product.shortName)}</p>
        <a class="text-link" href={localePath(lang, '/technology/')} style="margin-top: 24px;">{t.howWeWork} <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="product-features">
      {product.features.map((feature, index) => (
        <div class="product-feature reveal">
          <span>0{index + 1}</span>
          <h3>{feature.title}</h3>
          <p>{feature.copy}</p>
        </div>
      ))}
    </div>

    <section class="section section--tight">
      <div class="section-head">
        <div class="section-head__title">
          <span class="eyebrow">{t.relatedEyebrow}</span>
          <h2>{t.relatedTitleA} <em>{t.relatedTitleB}</em></h2>
        </div>
        <a class="text-link" href={localePath(lang, '/collections/')}>{t.allModels} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="product-grid">
        {related.map((item, index) => (
          <ProductCard product={item} index={index} lang={lang} />
        ))}
      </div>
    </section>
  </div>

  <Newsletter lang={lang} />
</BaseLayout>

<style>
  .product-stage--photo {
    display: grid;
    place-items: center;
  }

  .product-stage__photo {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 5%;
    mix-blend-mode: multiply;
  }

  .product-stage--photo:hover .product-stage__photo {
    transform: none;
  }

  .product-image-note {
    margin-top: 10px;
    font-size: 9px;
    line-height: 1.6;
    color: var(--ink-soft);
    opacity: 0.65;
  }

  .color-option.is-static {
    cursor: default;
  }

  .color-option.is-static:hover {
    transform: none;
  }

  .color-list {
    margin-top: 10px;
    font-size: 9px;
    line-height: 1.6;
    color: var(--ink-soft);
    opacity: 0.65;
  }

  @media (max-width: 760px) {
    .product-stage__photo {
      padding: 3%;
    }
  }
</style>
