---
import Logo from './Logo.astro';
import { products } from '../data/products';
import { localizeProduct } from '../i18n/products.es';
import { localePath, otherLocalePath, ui, type Lang } from '../i18n/ui';

interface Props {
  current?: string;
  lang?: Lang;
}

const { current = '', lang = 'en' } = Astro.props as Props;
const t = ui[lang];
const switchHref = otherLocalePath(lang, Astro.url.pathname);
const switchLang = lang === 'en' ? 'es' : 'en';
const searchProducts = products.map((product) => localizeProduct(product, lang));

const navLabels = lang === 'es'
  ? { drinkware: 'Productos', capabilities: 'Capacidades', company: 'Empresa', resources: 'Recursos', contact: 'Contacto' }
  : { drinkware: 'Drinkware', capabilities: 'Capabilities', company: 'Company', resources: 'Resources', contact: 'Contact' };

const links = [
  { href: localePath(lang, '/collections/'), label: navLabels.drinkware, key: 'shop' },
  { href: localePath(lang, '/technology/'), label: navLabels.capabilities, key: 'technology' },
  { href: localePath(lang, '/about/'), label: navLabels.company, key: 'about' },
  { href: localePath(lang, '/resources/'), label: navLabels.resources, key: 'resources' },
  { href: localePath(lang, '/contact/'), label: navLabels.contact, key: 'contact' },
];
---

<div class="announcement">
  <span>{t.announcement.one}</span>
  <span class="announcement__dot" aria-hidden="true">•</span>
  <span>{t.announcement.two}</span>
</div>

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="brand" href={localePath(lang, '/')} aria-label="ZCZR home">
      <Logo />
      <span class="brand__descriptor">{t.header.descriptor}</span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      {links.map((link) => (
        <a
          class:list={['main-nav__link', { 'is-active': current === link.key }]}
          href={link.href}
          aria-current={current === link.key ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="icon-button" type="button" data-search-toggle aria-label={t.header.search} aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.4" />
          <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </button>
      <a class="lang-switch" href={switchHref} hreflang={switchLang} aria-label={lang === 'en' ? 'Cambiar a español' : 'Switch to English'}>
        {t.langLabel}
      </a>
      <a class="header-cta" href={localePath(lang, '/contact/')}>{t.header.quote}</a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-label={t.header.menu} aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu__head">
    <Logo light />
    <button class="icon-button icon-button--light" type="button" data-menu-close aria-label={lang === 'es' ? 'Cerrar menú' : 'Close menu'}>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
  </div>
  <nav class="mobile-menu__nav" aria-label={lang === 'es' ? 'Navegación móvil' : 'Mobile navigation'}>
    {links.map((link, index) => (
      <a href={link.href}><span>{String(index + 1).padStart(2, '0')}</span>{link.label}</a>
    ))}
  </nav>
  <div class="mobile-menu__foot">
    <p>{t.header.tagline}</p>
    <a class="text-link" href={localePath(lang, '/contact/')}>{t.header.quote} <span aria-hidden="true">↗</span></a>
  </div>
</div>

<div class="search-panel" data-search-panel aria-hidden="true">
  <div class="search-panel__inner">
    <div class="search-panel__head">
      <span class="eyebrow">{t.header.searchTitle}</span>
      <button class="icon-button" type="button" data-search-close aria-label={lang === 'es' ? 'Cerrar búsqueda' : 'Close search'}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    </div>
    <label class="search-field">
      <span class="sr-only">{t.header.search}</span>
      <input type="search" placeholder={t.header.searchPlaceholder} data-search-input autocomplete="off" />
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.4" />
        <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </label>
    <div class="search-results" data-search-results>
      {searchProducts.map((product) => (
        <a class="search-result" href={localePath(lang, `/products/${product.slug}/`)} data-search-item data-search-text={`${product.name} ${product.categoryLabel} ${product.line}`}>
          <span class="search-result__thumb">
            <img src={product.image} alt="" width="120" height="120" loading="lazy" />
          </span>
          <span>
            <strong>{product.name}</strong>
            <small>{product.line} · {product.capacity}</small>
          </span>
          <span class="search-result__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
      <p class="search-empty" data-search-empty hidden>{t.header.searchEmpty}</p>
    </div>
  </div>
</div>
