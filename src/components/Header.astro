---
import Logo from './Logo.astro';
import { products } from '../data/products';

interface Props {
  current?: string;
}

const { current = '' } = Astro.props;

const links = [
  { href: '/collections/', label: 'Drinkware', key: 'shop' },
  { href: '/technology/', label: 'Capabilities', key: 'technology' },
  { href: '/about/', label: 'Company', key: 'about' },
  { href: '/resources/', label: 'Resources', key: 'resources' },
  { href: '/contact/', label: 'Contact', key: 'contact' },
];
---

<div class="announcement">
  <span>OEM / ODM insulated drinkware</span>
  <span class="announcement__dot" aria-hidden="true">•</span>
  <span>Samples available · Wuxi, Jiangsu, China</span>
</div>

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="ZCZR home">
      <Logo />
      <span class="brand__descriptor">Insulated drinkware</span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      {links.map((link) => (
        <a
          class:list={['main-nav__link', { 'is-active': current === link.key }]}
          href={link.href}
          aria-current={current === link.key ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="icon-button" type="button" data-search-toggle aria-label="Search drinkware" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.4" />
          <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </button>
      <a class="header-cta" href="/contact/">Request a quote</a>
      <button class="menu-toggle" type="button" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true">
  <div class="mobile-menu__head">
    <Logo light />
    <button class="icon-button icon-button--light" type="button" data-menu-close aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>
  </div>
  <nav class="mobile-menu__nav" aria-label="Mobile">
    {links.map((link, index) => (
      <a href={link.href}><span>{String(index + 1).padStart(2, '0')}</span>{link.label}</a>
    ))}
  </nav>
  <div class="mobile-menu__foot">
    <p>Insulated drinkware, built for your brand.</p>
    <a class="text-link" href="/contact/">Request a quote <span aria-hidden="true">↗</span></a>
  </div>
</div>

<div class="search-panel" data-search-panel aria-hidden="true">
  <div class="search-panel__inner">
    <div class="search-panel__head">
      <span class="eyebrow">Search the drinkware range</span>
      <button class="icon-button" type="button" data-search-close aria-label="Close search">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    </div>
    <label class="search-field">
      <span class="sr-only">Search products</span>
      <input type="search" placeholder="Try “tumbler”, “bottle”, or “vacuum”" data-search-input autocomplete="off" />
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.4" />
        <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </label>
    <div class="search-results" data-search-results>
      {products.map((product) => (
        <a class="search-result" href={`/products/${product.slug}/`} data-search-item data-search-text={`${product.name} ${product.categoryLabel} ${product.colors.map((c) => c.name).join(' ')}`}>
          <span class="search-result__thumb">
            <img src={product.image} alt="" width="120" height="120" loading="lazy" />
          </span>
          <span>
            <strong>{product.name}</strong>
            <small>{product.line} · {product.capacity}</small>
          </span>
          <span class="search-result__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
      <p class="search-empty" data-search-empty hidden>No models found. Try a different word.</p>
    </div>
  </div>
</div>
