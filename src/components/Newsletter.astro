---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class:list={['newsletter', { 'section--tight': compact }]} aria-labelledby="newsletter-title">
  <div class="newsletter__inner container">
    <div>
      <span class="eyebrow eyebrow--light">Buyer briefing</span>
      <h2 id="newsletter-title">New models.<br /><em>Factory notes.</em></h2>
    </div>
    <div class="newsletter__copy">
      <p>Occasional updates for sourcing teams: new drinkware models, finish options, packaging notes and production windows. No consumer noise.</p>
      <form class="newsletter-form" data-newsletter-form>
        <label class="sr-only" for="newsletter-email">Work email address</label>
        <input id="newsletter-email" type="email" name="email" placeholder="Work email" required />
        <button type="submit" aria-label="Subscribe">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
      </form>
      <p class="newsletter__note">For B2B buyers and sourcing teams. Unsubscribe anytime.</p>
      <p class="form-note" data-newsletter-note aria-live="polite"></p>
    </div>
  </div>
</section>
