---
import Header from '../components/Header.astro';
import { companyContacts, primaryContact } from '../data/contacts';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { languages, localePath, stripLocale, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  current?: string;
  image?: string;
  noIndex?: boolean;
  lang?: Lang;
}

const {
  title,
  description,
  current = '',
  image = '/images/company.webp',
  noIndex = false,
  lang: langProp = 'en',
} = Astro.props as Props;
const lang = langProp as Lang;

const canonical = new URL(Astro.url.pathname, Astro.site);
const cleanPath = stripLocale(Astro.url.pathname);
const alternateUrls = languages.map((code) => ({
  code,
  url: new URL(localePath(code, cleanPath === '/404/' ? '/404/' : cleanPath), Astro.site),
}));
const ogImage = new URL(image, Astro.site);
const siteNames: Record<Lang, string> = {
  en: 'ZCZR Insulated Drinkware',
  es: 'ZCZR Menaje Isotérmico',
  fr: 'ZCZR Gobelets Isothermes',
  zh: 'ZCZR 不锈钢保温饮具',
};
const ogLocales: Record<Lang, string> = { en: 'en_US', es: 'es_ES', fr: 'fr_FR', zh: 'zh_CN' };
const skipLabels: Record<Lang, string> = {
  en: 'Skip to content',
  es: 'Saltar al contenido',
  fr: 'Aller au contenu',
  zh: '跳到主要内容',
};
const siteName = siteNames[lang];
const legalName = 'Wuxi Zhenchuang Zhuorui International Trade Co., Ltd.';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: legalName,
  alternateName: 'ZCZR',
  url: Astro.site,
  email: primaryContact.email,
  telephone: primaryContact.tel,
  logo: new URL('/images/zczr-logo.png', Astro.site),
  description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Yixing',
    addressRegion: 'Jiangsu',
    addressCountry: 'CN',
  },
  contactPoint: companyContacts.map((contact) => ({
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: contact.email,
    telephone: contact.tel,
    areaServed: contact.regionEn,
    availableLanguage: ['English', 'Spanish', 'French', 'Chinese'],
  })),
  sameAs: [],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternateUrls.map((alternate) => (
      <link rel="alternate" hreflang={alternate.code} href={alternate.url} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateUrls[0].url} />
    {noIndex && <meta name="robots" content="noindex" />}
    <script is:inline>
      (() => {
        const supported = ['es', 'fr', 'zh'];
        const path = window.location.pathname;
        if (path !== '/' && path !== '') return;
        const browser = (navigator.languages?.[0] || navigator.language || 'en').toLowerCase();
        const detected = browser.startsWith('fr') ? 'fr' : browser.startsWith('zh') ? 'zh' : browser.startsWith('es') ? 'es' : 'en';
        let stored = null;
        try { stored = localStorage.getItem('zczr-language'); } catch {}
        const target = stored && ['en', ...supported].includes(stored) ? stored : detected;
        if (target !== 'en' && supported.includes(target)) {
          window.location.replace(`/${target}/${window.location.search}`);
        }
      })();
    </script>
    <meta name="theme-color" content="#F3EFE6" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={`${title} — ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    {lang === 'zh' && (
      <>
        <link rel="preload" href="/fonts/lxgw-wenkai-regular.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/lxgw-wenkai-medium.woff2" as="font" type="font/woff2" crossorigin />
      </>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabels[lang]}</a>
    <Header current={current} lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
